{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask app",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "FLASK_ENV": "development"
      },
      "serverReadyAction": {
        "pattern": "Running on http://127\\.0\\.0\\.1:(\\d+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "openExternally"
      }
    }
  ]
}
